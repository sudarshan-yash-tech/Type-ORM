{
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc --noEmit && tsup src/server.ts --format esm --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:format": "prisma format --schema prisma",
    "prisma:validate": "prisma validate --schema prisma",
    "prisma:generate": "prisma generate --schema prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma",
    "prisma:studio": "prisma studio --schema prisma",
    "typeorm": "typeorm-ts-node-esm",
    "migration:create": "npm run typeorm -- migration:create ./src/database/migrations",
    "migration:generate": "npm run typeorm -- migration:generate ./src/database/migrations",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show"
  },
  "type": "module"
}
